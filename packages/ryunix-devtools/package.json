{
  "name": "@unsetsoft/ryunix-devtools",
  "version": "1.3.1",
  "description": "DevTools extension for debugging Ryunix applications",
  "main": "manifest.json",
  "files": [
    "manifest.json",
    "devtools.html",
    "panel.html",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm run build:lib-ts",
    "build:manifest": "node scripts/sync-manifest.mjs",
    "build:lib-ts": "pnpm run build:manifest && tsc -p tsconfig.emit.json && prettier -w \"dist/**/*.js\" manifest.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ryunix",
    "devtools",
    "chrome-extension",
    "debugging"
  ],
  "author": "UnSetSoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UnSetSoft/Ryunixjs"
  }
}
