{
  "name": "@unsetsoft/ryunix-presets",
  "description": "Package with presets for different development environments.",
  "version": "1.0.26-canary.43",
  "author": "Neyunse",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnSetSoft/Ryunixjs.git",
    "directory": "packages/ryunix-presets"
  },
  "license": "MIT",
  "keywords": [
    "ryunixjs"
  ],
  "files": [
    ".generated/webpack",
    "webpack/config.d.ts",
    "webpack/utils/config.cjs.d.ts"
  ],
  "peerDependencies": {
    "@unsetsoft/ryunixjs": "^1.2.5-canary.0 || ^1.2.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./webpack/config.d.ts"
    },
    "./webpack": {
      "types": "./webpack/config.d.ts",
      "import": "./.generated/webpack/index.js",
      "default": "./.generated/webpack/index.js"
    }
  },
  "types": "./webpack/config.d.ts",
  "bin": {
    "ryunix": "./.generated/webpack/bin/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm run build:lib-ts && pnpm run build:assets",
    "build:lib-ts": "tsc -p tsconfig.emit.json && prettier -w \".generated/webpack/**/*.js\"",
    "build:assets": "node scripts/sync-webpack-assets.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "pnpm run build",
    "test": "node --test webpack/plugins/remark-github-alerts.test.mjs webpack/utils/ssgStaticParams.test.mjs webpack/utils/appRouterFlatMdx.test.mjs webpack/utils/styleConfig.test.mjs webpack/utils/styleFonts.test.mjs"
  },
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "dependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.28.5",
    "@babel/plugin-transform-react-jsx": "7.27.1",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@remark-embedder/core": "3.0.3",
    "@remark-embedder/transformer-oembed": "5.0.1",
    "@rollup/plugin-terser": "1.0.0",
    "@swc/core": "1.15.5",
    "@vitejs/plugin-react-swc": "4.3.0",
    "babel-loader": "10.0.0",
    "boxen": "8.0.1",
    "chalk": "5.6.2",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "8.0.0",
    "dotenv-webpack": "8.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-mdx": "3.6.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-webpack-plugin": "5.0.2",
    "glob": "13.0.6",
    "globals": "17.4.0",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.5",
    "jiti": "2.6.1",
    "mini-css-extract-plugin": "2.10.1",
    "postcss": "8.5.8",
    "postcss-loader": "8.2.1",
    "rehype-highlight": "7.0.2",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "rollup": "4.59.0",
    "sass": "1.97.0",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terminal-log": "1.0.1",
    "terser-webpack-plugin": "5.4.0",
    "thread-loader": "4.0.4",
    "vite": "8.0.0",
    "webpack": "5.105.4",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2",
    "yargs": "18.0.0"
  }
}
