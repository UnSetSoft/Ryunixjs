{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "node10",
    "types": ["node"],
    "skipLibCheck": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "webpack/**/*.ts",
    "webpack/**/*.d.ts",
    "webpack/types/presets-shims.d.ts"
  ],
  "exclude": ["node_modules", "webpack/template/**"]
}
