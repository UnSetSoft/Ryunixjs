{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".generated",
    "rootDir": "src",
    "declaration": false,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "templates"]
}
