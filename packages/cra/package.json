{
  "name": "@unsetsoft/cra",
  "description": "Create Ryunix app",
  "version": "1.1.20-canary.16",
  "author": "Neyunse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnSetSoft/Ryunixjs.git",
    "directory": "packages/cra"
  },
  "license": "MIT",
  "keywords": [
    "ryunixjs"
  ],
  "main": ".generated/cli.js",
  "bin": ".generated/cli.js",
  "files": [
    ".generated",
    "templates"
  ],
  "scripts": {
    "dev": "node ./.generated/cli.js",
    "build": "pnpm run build:lib-ts",
    "build:lib-ts": "tsc -p tsconfig.emit.json && prettier -w \".generated/**/*.js\"",
    "prepublishOnly": "npm run build",
    "nightly:release": "npm publish --tag nightly",
    "release": "npm publish",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.19.3"
  },
  "dependencies": {
    "command-exists-promise": "2.0.2",
    "commander": "14.0.3",
    "cross-spawn": "7.0.6",
    "picocolors": "1.1.1",
    "prompts": "2.4.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^20 || ^22 || ^24 || ^26"
  }
}
