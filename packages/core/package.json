{
  "name": "@unsetsoft/ryunixjs",
  "version": "1.2.5-canary.9",
  "license": "MIT",
  "main": "./dist/Ryunix.umd.js",
  "module": "./dist/Ryunix.esm.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/Ryunix.esm.js",
      "require": "./dist/Ryunix.umd.js",
      "default": "./dist/Ryunix.umd.js"
    },
    "./package.json": "./package.json",
    "./jsx-runtime": {
      "types": "./jsx/jsx-runtime.d.ts",
      "import": "./jsx/jsx-runtime.js",
      "require": "./jsx/jsx-runtime.js",
      "default": "./jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx/jsx-dev-runtime.d.ts",
      "import": "./jsx/jsx-dev-runtime.js",
      "require": "./jsx/jsx-dev-runtime.js",
      "default": "./jsx/jsx-dev-runtime.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "jsx",
    "types"
  ],
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:lib-ts": "tsc -p tsconfig.emit.json && prettier -w \"src/lib/**/*.js\" \"src/utils/**/*.js\" \"src/main.js\"",
    "prepublishOnly": "npm run build:lib-ts && npm run build",
    "canary:release": "npm publish --tag canary",
    "release": "npm publish",
    "lint": "eslint src jsx --max-warnings=0 --config ../../eslint.config.mjs",
    "prettier-check": "prettier -c .",
    "prettier-fix": "prettier -w .",
    "test": "jest --testPathPatterns=src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:checkjs": "tsc --noEmit -p tsconfig.checkjs.json"
  },
  "dependencies": {},
  "devDependencies": {
    "rollup": "4.59.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-typescript": "12.1.2",
    "@rollup/plugin-terser": "0.4.4",
    "eslint": "9.39.2",
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "jest": "30.2.0",
    "babel-jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0"
  },
  "engines": {
    "node": "20 || ^22 || ^24"
  },
  "keywords": [
    "ryunixjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "bugs": {
    "url": "https://github.com/UnSetSoft/Ryunixjs/issues"
  },
  "homepage": "https://github.com/UnSetSoft/Ryunixjs#readme"
}