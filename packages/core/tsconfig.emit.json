{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": false,
    "outDir": ".generated",
    "rootDir": "src",
    "declaration": false,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "node10",
    "removeComments": true
  },
  "include": ["src/lib/**/*.ts", "src/utils/**/*.ts", "src/main.ts"],
  "exclude": ["src/types/**/*.d.ts", "src/tests/**"]
}
