{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "node10",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "jsx/**/*.js",
    "jsx/**/*.d.ts",
    "types/**/*.d.ts",
    "types/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
